---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    class="inline-flex bg-white text-black border-black/20 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-black border dark:border-white/20 focus-visible:ring-[#00B1FF]/80 text-md hover:bg-[#00B1FF] hover:border-[#00B1FF] group max-w-fit rounded-xl hover:text-black focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black"
>
    <slot />
</a>
