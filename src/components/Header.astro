---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:diegocsalcedoz@gmail.com",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full text-black justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-[#00B1FF]"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <div class="ml-2 pl-2 border-l border-black/20">
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("nav-link-active")
              item.classList.remove("nav-link-inactive")
            } else {
              item.classList.remove("nav-link-active")
              item.classList.add("nav-link-inactive")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    --nav-background: rgb(255 255 255 / 0.8);
    --nav-border: rgb(0 0 0 / 0.12);
    --nav-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.12), 0 0 0 1px rgb(0 0 0 / 0.06);
    background-color: var(--nav-background);
    border-color: var(--nav-border);
    box-shadow: none;
    color: #000000;
  }

  :global(.dark) .header-nav {
    --nav-background: rgb(0 0 0 / 0.88);
    --nav-border: rgb(255 255 255 / 0.2);
    --nav-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.65), 0 0 0 1px rgb(255 255 255 / 0.14);
    background-color: var(--nav-background);
    border-color: var(--nav-border);
    color: #ffffff;
  }

  .nav-link-active {
    font-weight: 600;
    color: #00b1ff;
    background-color: rgb(0 177 255 / 0.14);
  }

  .nav-link-inactive {
    color: #000000;
  }

  :global(.dark) .nav-link-inactive {
    color: #ffffff;
  }

  :global(.dark) .header-nav > div {
    border-color: rgb(255 255 255 / 0.24);
  }

  @keyframes nav-appear {
    0% {
      background-color: rgb(255 255 255 / 0);
      border-color: transparent;
      box-shadow: none;
    }
    to {
      background-color: var(--nav-background);
      border-color: var(--nav-border);
      box-shadow: var(--nav-shadow);
      backdrop-filter: blur(12px);
    }
  }

  :global(.dark) .header-nav {
    backdrop-filter: blur(12px);
    box-shadow: var(--nav-shadow);
  }
</style>
