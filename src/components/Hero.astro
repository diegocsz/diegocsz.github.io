---
const personalImageAlt = "Miguel Ángel"
import Badge from "@/components/Badge.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-[#00B1FF]/30 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-20 ring-2 ring-[#00B1FF]/60 ring-offset-2 ring-offset-white dark:ring-offset-black"
        src="/midudev.webp"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/diegocsz"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> Disponible para trabajar</Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-black sm:text-5xl dark:text-white"
  >
    Hola, soy <span class="gradient-name">Diego Salcedo</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-black/80 dark:[&>strong]:text-[#00B1FF] [&>strong]:text-[#00B1FF] [&>strong]:font-semibold dark:text-white/80"
  >
    Estudiante de 6to ciclo. <strong
      >Ingeniería de Software y Creador de Contenido sobre Programación</strong
    > de Lima, Peru ᴘᴇ. Aprendo el desarrollo de aplicaciones web y
    mobile.
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Redes sociales y contacto"
  >
    <SocialPill href="mailto:diegocsalcedoz@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/diegocsz">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/diegocsz">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
